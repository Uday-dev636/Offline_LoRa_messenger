/*
  LoRa Chat Node - ESP32 (v3)
  --------------------------------------
  Role: this board is one "chat node". It hosts a WiFi hotspot + web
  dashboard so a phone can type a message, sends it over LoRa, and shows
  any message it receives from the other node (ESP8266 or another ESP32)
  both on its OLED and in the web dashboard.

  Hardware:
  - ESP32
  - SX1278 RA-02 (433 MHz)  <-- MUST be powered from 3.3V, NOT 5V/VIN.
    Wrong voltage or swapped SPI pins is the #1 cause of a LoRa module
    overheating. Double-check wiring before powering on:
      VCC  -> 3V3
      GND  -> GND
      SCK  -> 18
      MISO -> 19
      MOSI -> 23
      NSS  -> 5
      RST  -> 14
      DIO0 -> 2
  - SSD1306 128x64 OLED (I2C: SDA 21, SCL 22)

  Libraries:
    LoRa by Sandeep Mistry
    Adafruit GFX
    Adafruit SSD1306

  Key fixes vs earlier version:
  - setup() no longer hangs forever if the OLED or LoRa module fails to
    init. Previously a failed LoRa.begin() would freeze in setup(),
    which meant loop() (and therefore the web server) never ran, so the
    dashboard page never loaded even though the WiFi AP was up.
  - LoRa init is retried automatically every 5s if it failed at boot, so
    if you fix the wiring you don't have to re-flash.
  - Dashboard shows live hardware status (OLED ok / LoRa ok) so you can
    diagnose from the phone instead of guessing.
  - OLED walks through the exact flow you described: shows the typed
    message -> "Sending..." -> "Sent", and on the receiving side:
    "Received" -> the message text.
*/

#include <WiFi.h>
#include <WebServer.h>
#include <SPI.h>
#include <LoRa.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ---------- Node identity ----------
// Give each board a different name so messages in the dashboard are
// distinguishable once you have two nodes talking to each other.
const char* NODE_NAME = "ESP32-A";

// ---------- OLED ----------
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);
bool oledOk = false;

// ---------- LoRa pins ----------
#define LORA_SS   5
#define LORA_RST 14
#define LORA_DIO0 15  // GPIO15 - strapping pin, only affects boot log output, safe to use
#define LORA_SCK 18
#define LORA_MISO 19
#define LORA_MOSI 23
#define LORA_FREQ 433E6

bool loraOk = false;
unsigned long lastLoraRetry = 0;
const unsigned long LORA_RETRY_INTERVAL_MS = 5000;

// ---------- WiFi AP ----------
const char* AP_SSID = "LoRa_Messenger";
const char* AP_PASS = "12345678"; // change before real use, min 8 chars for WPA2
WebServer server(80);

// ---------- Limits ----------
static const size_t MAX_MSG_LEN = 180;
static const uint8_t HISTORY_SIZE = 10;

struct Message {
  String text;
  int rssi;
  unsigned long millisAt;
  bool outgoing;
};
Message history[HISTORY_SIZE];
uint8_t historyCount = 0;
uint8_t historyHead = 0;

void pushHistory(const String& text, int rssi, bool outgoing) {
  uint8_t idx = (historyHead + historyCount) % HISTORY_SIZE;
  if (historyCount < HISTORY_SIZE) {
    historyCount++;
  } else {
    historyHead = (historyHead + 1) % HISTORY_SIZE;
    idx = (historyHead + HISTORY_SIZE - 1) % HISTORY_SIZE;
  }
  history[idx] = { text, rssi, millis(), outgoing };
}

// ---------- Escaping helpers ----------
String htmlEscape(const String& in) {
  String out; out.reserve(in.length() + 16);
  for (size_t i = 0; i < in.length(); i++) {
    char c = in[i];
    switch (c) {
      case '&': out += "&amp;"; break;
      case '<': out += "&lt;"; break;
      case '>': out += "&gt;"; break;
      case '"': out += "&quot;"; break;
      case '\'': out += "&#39;"; break;
      default: out += c;
    }
  }
  return out;
}

String jsonEscape(const String& in) {
  String out; out.reserve(in.length() + 8);
  for (size_t i = 0; i < in.length(); i++) {
    char c = in[i];
    if (c == '"' || c == '\\') { out += '\\'; out += c; }
    else if (c == '\n') out += "\\n";
    else if ((uint8_t)c < 0x20) { /* skip */ }
    else out += c;
  }
  return out;
}

// ---------- OLED helper (safe no-op if OLED failed to init) ----------
void showText(const String& title, const String& msg) {
  Serial.println(title + ": " + msg);
  if (!oledOk) return;
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println(title);
  display.drawLine(0, 10, 127, 10, WHITE);
  display.setCursor(0, 18);
  display.println(msg);
  display.display();
}

// ---------- LoRa send ----------
bool sendLoRa(const String& txt) {
  if (!loraOk) return false;
  showText("Message", txt);
  delay(150);
  showText("Sending...", txt);
  LoRa.beginPacket();
  LoRa.print(txt);
  bool ok = LoRa.endPacket();
  showText(ok ? "Sent" : "Send failed", txt);
  return ok;
}

// ---------- LoRa receive (polled each loop, non-blocking) ----------
void pollLoRaReceive() {
  if (!loraOk) return;
  int packetSize = LoRa.parsePacket();
  if (packetSize == 0) return;

  String incoming; incoming.reserve(packetSize);
  while (LoRa.available()) incoming += (char)LoRa.read();
  int rssi = LoRa.packetRssi();
  if (incoming.length() == 0) return;
  if (incoming.length() > MAX_MSG_LEN) incoming = incoming.substring(0, MAX_MSG_LEN);

  pushHistory(incoming, rssi, false);
  showText("Received", incoming);
}

// ---------- Try (re)initializing LoRa without blocking anything ----------
void tryInitLoRa() {
  SPI.end();
  SPI.begin(LORA_SCK, LORA_MISO, LORA_MOSI, LORA_SS);
  LoRa.setPins(LORA_SS, LORA_RST, LORA_DIO0);
  if (LoRa.begin(LORA_FREQ)) {
    LoRa.setSyncWord(0x12);
    loraOk = true;
    showText("LoRa ready", String(LORA_FREQ / 1E6, 0) + " MHz");
  } else {
    loraOk = false;
    showText("LoRa error", "check wiring");
  }
}

// ---------- Web page ----------
const char webpage[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>LoRa Messenger</title>
<style>
body{font-family:Arial;background:#111;color:#fff;text-align:center;padding:20px;margin:0;}
textarea{width:95%;max-width:500px;height:100px;font-size:18px;border-radius:8px;padding:10px;box-sizing:border-box;}
button{margin-top:12px;padding:14px 30px;font-size:20px;border:none;border-radius:10px;background:#0b84ff;color:white;}
button:disabled{background:#555;}
#status{min-height:20px;margin-top:8px;font-size:14px;color:#9ad;}
#hw{font-size:12px;color:#888;margin-top:4px;}
#log{max-width:500px;margin:20px auto;text-align:left;}
.msg{background:#1c1c1c;border-radius:8px;padding:8px 12px;margin:6px 0;}
.msg.out{border-left:4px solid #0b84ff;}
.msg.in{border-left:4px solid #35c759;}
.meta{font-size:11px;color:#888;margin-top:2px;}
</style>
</head>
<body>
<h2 id="title">LoRa Messenger</h2>
<div id="hw">checking hardware...</div>
<textarea id="msg" maxlength="180" placeholder="Type a message..."></textarea><br>
<button id="sendBtn" onclick="sendMsg()">Send</button>
<div id="status"></div>
<div id="log"></div>
<script>
const charLimit = 180;
async function sendMsg(){
  const ta = document.getElementById('msg');
  const btn = document.getElementById('sendBtn');
  const status = document.getElementById('status');
  const text = ta.value.trim();
  if(!text){ status.textContent = "Type something first."; return; }
  if(text.length > charLimit){ status.textContent = "Message too long."; return; }
  btn.disabled = true;
  status.textContent = "Sending...";
  try{
    const res = await fetch('/send', {
      method:'POST',
      headers:{'Content-Type':'application/x-www-form-urlencoded'},
      body:'msg=' + encodeURIComponent(text)
    });
    const bodyText = await res.text();
    status.textContent = res.ok ? "Sent." : ("Failed: " + bodyText);
    if(res.ok) ta.value = "";
    refresh();
  } catch(e){
    status.textContent = "Network error.";
  }
  btn.disabled = false;
}
async function refreshStatus(){
  try{
    const res = await fetch('/status');
    const s = await res.json();
    document.getElementById('title').textContent = 'LoRa Messenger - ' + s.node;
    document.getElementById('hw').textContent =
      'OLED: ' + (s.oled ? 'ok' : 'not detected') +
      ' | LoRa: ' + (s.lora ? 'ok' : 'not connected (check wiring)');
  } catch(e) {}
}
async function refresh(){
  try{
    const res = await fetch('/messages');
    const data = await res.json();
    const log = document.getElementById('log');
    log.innerHTML = data.map(m => {
      const cls = m.out ? 'out' : 'in';
      const dir = m.out ? 'You' : ('Received (RSSI ' + m.rssi + ')');
      return '<div class="msg ' + cls + '"><div>' + m.text + '</div>' +
             '<div class="meta">' + dir + ' &middot; ' + (m.age) + 's ago</div></div>';
    }).join('');
  } catch(e) {}
}
setInterval(refresh, 3000);
setInterval(refreshStatus, 5000);
refresh();
refreshStatus();
</script>
</body>
</html>
)rawliteral";

// ---------- HTTP handlers ----------
void handleRoot() {
  server.send_P(200, "text/html", webpage);
}

void handleSend() {
  if (!server.hasArg("msg")) {
    server.send(400, "text/plain", "Missing 'msg' field");
    return;
  }
  String msg = server.arg("msg");
  msg.trim();
  if (msg.length() == 0) {
    server.send(400, "text/plain", "Empty message");
    return;
  }
  if (msg.length() > MAX_MSG_LEN) msg = msg.substring(0, MAX_MSG_LEN);

  if (!loraOk) {
    server.send(503, "text/plain", "LoRa not connected - check wiring");
    return;
  }

  bool ok = sendLoRa(msg);
  pushHistory(msg, 0, true);
  server.send(ok ? 200 : 502, "text/plain", ok ? "OK" : "LoRa send failed");
}

void handleMessages() {
  String json = "[";
  unsigned long now = millis();
  for (uint8_t i = 0; i < historyCount; i++) {
    uint8_t idx = (historyHead + i) % HISTORY_SIZE;
    Message& m = history[idx];
    if (i > 0) json += ",";
    json += "{\"text\":\"" + jsonEscape(htmlEscape(m.text)) + "\",";
    json += "\"rssi\":" + String(m.rssi) + ",";
    json += "\"out\":" + String(m.outgoing ? "true" : "false") + ",";
    json += "\"age\":" + String((now - m.millisAt) / 1000);
    json += "}";
  }
  json += "]";
  server.send(200, "application/json", json);
}

void handleStatus() {
  String json = "{";
  json += "\"node\":\"" + String(NODE_NAME) + "\",";
  json += "\"oled\":" + String(oledOk ? "true" : "false") + ",";
  json += "\"lora\":" + String(loraOk ? "true" : "false");
  json += "}";
  server.send(200, "application/json", json);
}

void handleNotFound() {
  server.send(404, "text/plain", "Not found");
}

// ---------- Setup ----------
void setup() {
  Serial.begin(115200);
  delay(200);

  Wire.begin(21, 22);
  oledOk = display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  if (!oledOk) {
    Serial.println("OLED not detected - continuing without display");
  }
  showText("Starting", NODE_NAME);

  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);

  server.on("/", handleRoot);
  server.on("/send", HTTP_POST, handleSend);
  server.on("/messages", HTTP_GET, handleMessages);
  server.on("/status", HTTP_GET, handleStatus);
  server.onNotFound(handleNotFound);
  server.begin();

  tryInitLoRa(); // if this fails, we do NOT hang - dashboard stays reachable

  showText("Ready", String("Join: ") + AP_SSID + "\n192.168.4.1");
  Serial.print("AP IP: ");
  Serial.println(WiFi.softAPIP());
}

// ---------- Loop ----------
void loop() {
  server.handleClient();
  pollLoRaReceive();

  if (!loraOk && millis() - lastLoraRetry > LORA_RETRY_INTERVAL_MS) {
    lastLoraRetry = millis();
    tryInitLoRa();
  }
}
